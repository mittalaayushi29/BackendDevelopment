<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Session Login</title>

</head>

<body>

<h1>Node.js Sessions & Cookies</h1>

<h2>Login</h2>

<form method="POST" action="/login">

    <label>
        Username:
    </label>

    <input
        type="text"
        name="username"
        value="<%= username %>"
        required
    >

    <button type="submit">
        Login
    </button>

</form>

</body>

</html>